{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for SixSeven community members",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 80 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_]{3,30}$" },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 200 },
        "score67": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName"]
    },
    "Post": {
      "title": "Post",
      "description": "A 6 7 meme video post on SixSeven",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 80 },
        "authorHandle": { "type": "string", "maxLength": 50 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 300 },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "soundTitle": { "type": "string", "maxLength": 120 },
        "memeTag": { "type": "string", "maxLength": 50 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "caption", "soundTitle"]
    },
    "Like": {
      "title": "Like",
      "description": "A user like on a 6 7 post",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "postId"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment under a 6 7 video post",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 80 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "text": { "type": "string", "maxLength": 300, "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "authorName", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection indexed by user UID"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Feed posts collection"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/Like" },
      "description": "Subcollection of likes on a post"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Subcollection of comments on a post"
    }
  }
}
