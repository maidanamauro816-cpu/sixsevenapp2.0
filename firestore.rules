rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName']) &&
        data.keys().hasOnly(['uid', 'username', 'displayName', 'photoURL', 'coverURL', 'bio', 'score67', 'createdAt', 'followersCount', 'followingCount', 'phoneNumber', 'displayNameLower']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
        data.displayName is string && data.displayName.size() <= 80 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('coverURL' in data) || (data.coverURL is string && data.coverURL.size() <= 500)) &&
        (!('score67' in data) || data.score67 is number);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'caption', 'soundTitle']) &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.caption is string && data.caption.size() <= 300 &&
        data.soundTitle is string && data.soundTitle.size() <= 120 &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 80)) &&
        (!('authorHandle' in data) || (data.authorHandle is string && data.authorHandle.size() <= 50)) &&
        (!('authorPhoto' in data) || (data.authorPhoto is string && data.authorPhoto.size() <= 500)) &&
        (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500)) &&
        (!('memeTag' in data) || (data.memeTag is string && data.memeTag.size() <= 50)) &&
        (!('likesCount' in data) || data.likesCount is number) &&
        (!('commentsCount' in data) || data.commentsCount is number) &&
        (!('sharesCount' in data) || data.sharesCount is number) &&
        (!('viewsCount' in data) || data.viewsCount is number);
    }

    function isValidLike(data) {
      return data.keys().hasAll(['userId', 'postId']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.postId is string && data.postId.size() <= 128;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'authorId', 'authorName', 'text']) &&
        data.postId is string && data.postId.size() <= 128 &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 80 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 300;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == existing().uid;

      // Each user can manage only their own saved contacts.
      match /contacts/{contactId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && contactId == incoming().uid
          && incoming().keys().hasAll(['uid', 'displayName', 'username', 'photoURL', 'addedAt'])
          && incoming().keys().hasOnly(['uid', 'displayName', 'username', 'photoURL', 'addedAt'])
          && incoming().uid is string
          && incoming().displayName is string
          && incoming().username is string
          && incoming().photoURL is string;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Chats 1 a 1 (id = uid menor + '_' + uid mayor)
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['participants', 'members', 'lastMessage', 'lastSender', 'updatedAt', 'unread'])
        && incoming().participants.size() == 2
        && request.auth.uid in incoming().participants
        && incoming().participants[0] < incoming().participants[1]
        && chatId == incoming().participants[0] + '_' + incoming().participants[1]
        && exists(/databases/$(database)/documents/friendships/$(chatId));
      allow update: if isSignedIn()
        && request.auth.uid in existing().participants
        && incoming().participants == existing().participants
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSender', 'updatedAt', 'unread']);

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && incoming().keys().hasOnly(['senderId', 'text', 'createdAt', 'mediaUrl', 'mediaType', 'mediaName', 'mimeType'])
          && incoming().senderId == request.auth.uid
          && incoming().text is string && incoming().text.size() <= 2000
          && (incoming().text.size() > 0 || ('mediaUrl' in incoming() && incoming().mediaUrl is string && incoming().mediaUrl.size() <= 2000))
          && (!('mediaUrl' in incoming()) || (incoming().mediaUrl is string && incoming().mediaUrl.size() <= 2000))
          && (!('mediaType' in incoming()) || incoming().mediaType in ['image', 'video', 'audio', 'gif'])
          && (!('mediaName' in incoming()) || (incoming().mediaName is string && incoming().mediaName.size() <= 150))
          && (!('mimeType' in incoming()) || (incoming().mimeType is string && incoming().mimeType.size() <= 100));
      }
    }

    function pairOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Solicitudes de amistad / chat (id = quien envía + '_' + quien recibe)
    match /friendRequests/{reqId} {
      allow read: if isSignedIn() && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['from', 'to', 'fromName', 'fromPhoto', 'fromUsername', 'toName', 'toPhoto', 'toUsername', 'status', 'createdAt', 'updatedAt'])
        && incoming().from == request.auth.uid
        && incoming().to is string && incoming().to != incoming().from
        && reqId == incoming().from + '_' + incoming().to
        && incoming().status == 'pending';
      allow update: if isSignedIn()
        && existing().to == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().status in ['accepted', 'declined'];
      allow delete: if isSignedIn() && (existing().from == request.auth.uid || existing().to == request.auth.uid);
    }

    // Amistades (id = uid menor + '_' + uid mayor). Se crea al aceptar una solicitud.
    match /friendships/{pairKey} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.users);
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['users', 'members', 'createdAt'])
        && incoming().users.size() == 2
        && request.auth.uid in incoming().users
        && incoming().users[0] < incoming().users[1]
        && pairKey == incoming().users[0] + '_' + incoming().users[1]
        && get(/databases/$(database)/documents/friendRequests/$(
             incoming().users[0] == request.auth.uid
               ? incoming().users[1] + '_' + request.auth.uid
               : incoming().users[0] + '_' + request.auth.uid
           )).data.status == 'accepted';
    }

    // Notes visible to signed-in users; each user may manage only their own note.
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && noteId == request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().keys().hasAll(['uid', 'name', 'photoURL', 'text', 'emoji', 'color', 'songTitle', 'createdAt', 'expiresAt'])
        && incoming().keys().hasOnly(['uid', 'name', 'photoURL', 'text', 'emoji', 'color', 'songTitle', 'createdAt', 'expiresAt'])
        && incoming().name is string && incoming().name.size() <= 80
        && incoming().photoURL is string && incoming().photoURL.size() <= 500
        && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 80
        && incoming().emoji is string && incoming().emoji.size() <= 16
        && incoming().color is string && incoming().color.size() <= 20
        && incoming().songTitle is string && incoming().songTitle.size() <= 100
        && incoming().expiresAt is timestamp;
      allow delete: if isSignedIn() && noteId == request.auth.uid;
    }
    // Stories expire after 24 hours; signed-in users can view them, owners can create/delete.
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().keys().hasAll(['uid', 'name', 'avatar', 'text', 'sticker', 'filter', 'songTitle', 'createdAt', 'expiresAt'])
        && incoming().keys().hasOnly(['uid', 'name', 'avatar', 'text', 'sticker', 'filter', 'songTitle', 'mediaUrl', 'mediaType', 'createdAt', 'expiresAt'])
        && incoming().name is string && incoming().name.size() <= 80
        && incoming().avatar is string && incoming().avatar.size() <= 500
        && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 300
        && incoming().sticker is string && incoming().sticker.size() <= 50
        && incoming().filter is string && incoming().filter.size() <= 30
        && incoming().songTitle is string && incoming().songTitle.size() <= 100
        && (!('mediaUrl' in incoming()) || (incoming().mediaUrl is string && incoming().mediaUrl.size() <= 1000))
        && (!('mediaType' in incoming()) || incoming().mediaType in ['', 'image', 'video'])
        && incoming().expiresAt is timestamp;
      allow update: if false;
      allow delete: if isSignedIn() && existing().uid == request.auth.uid;
    }
    // Posts Collection
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) && incoming().authorId == request.auth.uid && isValidPost(incoming());
      allow update: if isSignedIn() && isValidPost(incoming()) && (
        (incoming().authorId == request.auth.uid && incoming().authorId == existing().authorId) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount', 'viewsCount']))
      );
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;

      // Subcollection: Likes
      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidLike(incoming()) && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Subcollection: Comments
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(commentId) && incoming().authorId == request.auth.uid && isValidComment(incoming());
        allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
      }
    }
  }
}
