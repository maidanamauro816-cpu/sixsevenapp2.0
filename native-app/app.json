{
  "expo": {
    "name": "SixSeven Native",
    "slug": "sixseven-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sixseven",
    "android": {
      "package": "com.sixseven.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.736849153214-l1at2n4a5ju4ck11easi5hftjuo62s3m"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SixSeven necesita acceder a tus fotos para enviarlas en los chats.",
          "cameraPermission": "SixSeven necesita acceder a la cámara para compartir fotos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "SixSeven necesita el micrófono para grabar notas de voz."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff2020"
        }
      ]
    ]
  }
}