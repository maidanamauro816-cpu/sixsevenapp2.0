rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos and covers: readable by authenticated users, writable only by the owner.
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Chat attachments: the sender writes only into their own namespace.
    // Authenticated users can read a media URL when it is shared in a permitted chat message.
    match /users/{userId}/chat-media/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*'));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Story media is readable by authenticated SixSeven users; only the owner may upload/delete.
    match /stories/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}