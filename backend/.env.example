# Copy to .env on the server; never commit the real .env
NODE_ENV=production
PORT=4000
MONGO_URL=mongodb://mongo:27017/sixseven
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=https://your-domain.example
# Cloudflare R2 S3 API
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sixseven-media
R2_PUBLIC_BASE_URL=
# Billing providers are disabled until real credentials/webhooks are configured
REVENUECAT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_LABEL=ARS 2000/mes
BUSINESS_PRICE_LABEL=ARS 5000/mes
FREE_ORB_USES_PER_DAY=5